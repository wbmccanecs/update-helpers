<ivy-module version="2.0">
    <info organisation="com.mgic" module="case_manager"/>

    <configurations>
        <conf name="compile" description="used for building"/>
        <conf name="runtime" description="used for running"/>
        <conf name="sources" description="used for debugging"/>
    </configurations>

    <dependencies>

        <!-- Compile & Testing -->
        <dependency org="jakarta.servlet.jsp" name="jakarta.servlet.jsp-api" rev="4.0.0" conf="compile->default" />
        <dependency org="xmlunit" name="xmlunit" rev="1.5" conf="runtime->default" />
        <dependency org="junit" name="junit" rev="4.13.2" conf="compile->default" />
        <dependency org="org.mockito" name="mockito-core" rev="5.23.0" conf="compile->default" />
        <dependency org="net.bytebuddy" name="byte-buddy-agent" rev="1.17.8" conf="compile->default" />


        <!-- Spring -->
        <dependency org="org.springframework" name="spring-context" rev="6.2.19" conf="runtime->default" />
        <dependency org="org.springframework" name="spring-jms" rev="6.2.19" conf="runtime->default" />
        <dependency org="org.springframework" name="spring-messaging" rev="6.2.19" conf="runtime->default" />
        <dependency org="org.springframework" name="spring-test" rev="6.2.19" conf="runtime->default" />
        <dependency org="org.springframework" name="spring-tx" rev="6.2.19" conf="runtime->default" />
        <dependency org="org.springframework.data" name="spring-data-jpa" rev="3.5.12" conf="runtime->default" />
        <dependency org="org.springframework" name="spring-web" rev="6.2.19" conf="runtime->default" />
        <dependency org="org.springframework" name="spring-webmvc" rev="6.2.19" conf="runtime->default" />
        <dependency org="org.springframework" name="spring-websocket" rev="6.2.19" conf="runtime->default" />


        <!-- Hibernate -->
        <dependency org="org.hibernate.orm" name="hibernate-core" rev="6.6.54.Final" conf="runtime->default" />
        <dependency org="org.dom4j" name="dom4j" rev="2.2.0" conf="runtime->default" />
        <dependency org="net.bytebuddy" name="byte-buddy" rev="1.17.8" conf="runtime->default" />
        <dependency org="jakarta.persistence" name="jakarta.persistence-api" rev="3.2.0" conf="runtime->default" />
        <dependency org="jakarta.transaction" name="jakarta.transaction-api" rev="2.0.1" conf="runtime->default" />
        <dependency org="org.hibernate.orm" name="hibernate-jpamodelgen" rev="6.6.54.Final" conf="runtime->default" />
        <dependency org="com.ibm.db2" name="jcc" rev="11.5.9.0" conf="runtime->default" />
        <dependency org="org.hibernate.orm" name="hibernate-community-dialects" rev="6.6.54.Final" conf="runtime->default" />
        <dependency org="org.hibernate.validator" name="hibernate-validator" rev="8.0.0.Final" conf="runtime->default" />
        <dependency org="org.hibernate.validator" name="hibernate-validator-annotation-processor" rev="8.0.0.Final" conf="runtime->default" />


        <!-- Apache Commons -->
        <dependency org="commons-beanutils" name="commons-beanutils" rev="1.11.0" conf="runtime->default" />
        <dependency org="org.apache.commons" name="commons-collections4" rev="4.5.0" conf="runtime->default" />
        <dependency org="org.apache.commons" name="commons-dbcp2" rev="2.14.0" conf="runtime->default" />
        <dependency org="commons-io" name="commons-io" rev="2.22.0" conf="runtime->default" />
        <dependency org="org.apache.commons" name="commons-lang3" rev="3.20.0" conf="runtime->default" />
        <dependency org="org.apache.commons" name="commons-fileupload2-jakarta-servlet6" rev="2.0.0-M5" conf="runtime->default" />


        <!-- Logging -->
        <dependency org="org.apache.logging.log4j" name="log4j-api" rev="2.26.1" conf="runtime->default" />
        <dependency org="org.apache.logging.log4j" name="log4j-core" rev="2.26.1" conf="runtime->default" />
        <dependency org="org.apache.logging.log4j" name="log4j-slf4j2-impl" rev="2.26.1" conf="runtime->default" />
        <dependency org="org.slf4j" name="jcl-over-slf4j" rev="2.0.18" conf="runtime->default" />
        <dependency org="org.slf4j" name="slf4j-api" rev="2.0.18" conf="runtime->default" />


        <!-- Miscellaneous -->
        <dependency org="jaxen" name="jaxen" rev="2.0.6" conf="runtime->default" />
        <dependency org="org.owasp.encoder" name="encoder" rev="1.3.1" conf="runtime->default" />
        <dependency org="com.fasterxml.jackson.core" name="jackson-databind" rev="2.22.1" conf="runtime->default" />
        <dependency org="org.eclipse.angus" name="angus-mail" rev="2.1.0-M1" conf="runtime->default" />
        <dependency org="org.apache.logging.log4j" name="log4j-jakarta-smtp" rev="2.26.1" conf="runtime->default" />
        <dependency org="joda-time" name="joda-time" rev="2.14.2" conf="runtime->default" />
        <dependency org="com.itextpdf" name="itextpdf" rev="5.5.13.5" conf="runtime->default" />


        <dependency org="jakarta.xml.bind" name="jakarta.xml.bind-api" rev="4.0.5" conf="runtime->default" />
        <dependency org="org.projectlombok" name="lombok" rev="1.18.46" conf="runtime->default" />

        <!-- required for git deploys -->
        <dependency org="jakarta.annotation" name="jakarta.annotation-api" rev="3.0.0" conf="runtime->default" />
        <dependency org="jakarta.xml.soap" name="jakarta.xml.soap-api" rev="3.0.2" conf="runtime->default" />


        <!-- CAS for SSO -->
        <dependency org="org.apereo.cas.client" name="cas-client-core" rev="4.0.4" conf="runtime->default" />
        <dependency org="com.nimbusds" name="nimbus-jose-jwt" rev="10.9.1" conf="runtime->default" />

        <!-- Sitemesh -->
        <dependency org="opensymphony" name="sitemesh" rev="2.7.0-M1" conf="runtime->default" />


        <!-- Taglibs -->
        <dependency org="com.github.hazendaz" name="displaytag" rev="3.8.0" conf="runtime->default" />
        <!--        <dependency org="org.apache.xmlgraphics" name="fop" rev="2.10" conf="runtime->default" />xml-->
        <dependency org="org.glassfish.web" name="jakarta.servlet.jsp.jstl" rev="3.0.1" conf="runtime->default" />
        <dependency org="jakarta.servlet.jsp.jstl" name="jakarta.servlet.jsp.jstl-api" rev="3.0.2" conf="runtime->default" />
        <dependency org="org.owasp.encoder" name="encoder-jakarta-jsp" rev="1.4.0" conf="runtime->default" />

        <dependency org="org.apache.httpcomponents.client5" name="httpclient5" rev="5.6.2" conf="runtime->default" />

        <!-- Excludes -->
        <exclude org="commons-logging"/>

    </dependencies>
</ivy-module>